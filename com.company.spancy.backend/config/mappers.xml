<?xml version="1.0" encoding="utf-8" ?>
<objects xmlns="http://www.springframework.net">
    <object id="ProductMapper" type="com.company.spancy.backend.mapper.impl.BaseMapper&lt;com.company.spancy.backend.dto.ProductDto,com.company.spancy.backend.entity.Product>, com.company.spancy.backend"></object>
    <object id="BookMapper" type="com.company.spancy.backend.mapper.impl.BookMapper, com.company.spancy.backend"></object>
    <object id="CustomerMapper" type="com.company.spancy.backend.mapper.impl.CustomerMapper, com.company.spancy.backend"></object>
    <object id="StudentMapper" type="com.company.spancy.backend.mapper.impl.StudentMapper, com.company.spancy.backend">
        <property name="Dao" ref="StudentDao"/>
        <property name="Hql" value="from Student s where lower(s.Name) = lower(:Name)" />
    </object>
    <object id="PersonMapper" type="com.company.spancy.backend.mapper.impl.PersonMapper, com.company.spancy.backend">
        <property name="Dao" ref="PersonDao"/>
        <property name="Hql" value="from Person p where lower(p.Name) = lower(:Name) and p.Id = :Id" />
    </object>
</objects>
