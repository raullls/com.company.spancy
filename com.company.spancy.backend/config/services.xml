<?xml version="1.0" encoding="UTF-8"?>
<objects xmlns="http://www.springframework.net">
    <object id="BaseService" type="com.company.spancy.backend.service.impl.BaseService, com.company.spancy.backend" abstract="true">
        <property name="Logging" ref="CustomLoggingAdvice" />
        <property name="MessageSource" ref="messageSource" />
    </object> 
    <object id="ProductService" type="com.company.spancy.backend.service.impl.ProductService, com.company.spancy.backend" parent="BaseService" >
        <property name="ErrorMsges">
            <list>
                <value>error.objectsamename</value>
            </list>
        </property>
        <property name="Hql" value="from Product p where lower(p.Name) = lower(:Name)" />
        <property name="Dao" ref="ProductDao" />
        <property name="Mapper" ref="ProductMapper" />
    </object>
    <object id="BookService" type="com.company.spancy.backend.service.impl.BookService, com.company.spancy.backend" parent="BaseService">
        <property name="ErrorMsges">
        <list>
            <value>error.objectsamename</value>
        </list>
        </property>
        <property name="Hql" value="from Book b where lower(b.Name) = lower(:Name) and lower(b.Shipping.City) = lower(:Shipping.City)" />
        <property name="Dao" ref="BookDao"/>
        <property name="Mapper" ref="BookMapper"/>
    </object>
    <object id="CustomerService" type="com.company.spancy.backend.service.impl.CustomerService, com.company.spancy.backend" parent="BaseService">
        <property name="ErrorMsges">
        <list>
            <value>error.objectsamename</value>
        </list>
        </property>
        <property name="Hql" value="from Customer c where lower(c.Name) = lower(:Name) and c.Cart.Amount = :Cart.Amount" />
        <property name="Dao" ref="CustomerDao"/>
        <property name="Mapper" ref="CustomerMapper"/>
    </object>
    <object id="StudentService" type="com.company.spancy.backend.service.impl.StudentService, com.company.spancy.backend" parent="BaseService">
        <property name="ErrorMsges">
        <list>
            <value>error.objectsamename</value>
            <value>error.inexistentmentor</value>
        </list>
        </property>
        <property name="Hql" value="from Student s where lower(s.Name) = lower(:Name) and (s.Id = 0 or s.Id != :Id)" />
        <property name="Dao" ref="StudentDao"/>
        <property name="Mapper" ref="StudentMapper"/>
    </object>
</objects>
