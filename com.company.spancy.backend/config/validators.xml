<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net" xmlns:v="http://www.springframework.net/validation">
    <v:group id="productValidator">
        <v:condition test="#root != null">
            <v:message id="error.emptynullcheck" providers="provider">
                <v:param value="#root"></v:param>
            </v:message>
        </v:condition>
    </v:group>
</objects>