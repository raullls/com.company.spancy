<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net" xmlns:v="http://www.springframework.net/validation">
    <v:group id="dtoValidator">
        <v:condition test="#root != null">
        <v:message id="error.emptynullcheck" providers="provider">
            <v:param value="#root"></v:param>
        </v:message>
        </v:condition>
    </v:group>
    <v:group id="productValidator">
        <v:condition test="#root != null">
            <v:message id="error.emptynullcheck" providers="provider">
                <v:param value="#root"></v:param>
            </v:message>
        </v:condition>
    </v:group>
    <v:group id="bookValidator">
        <v:condition test="#root != null and #root.Name != null and #root.Name != '' and #root.City != null and #root.City != ''">
        <v:message id="error.emptynullcheck" providers="provider">
            <v:param value="#root"></v:param>
        </v:message>
        </v:condition>
    </v:group>
    <v:group id="customerValidator">
        <v:condition test="#root != null and #root.Name != null and #root.Name != ''">
        <v:message id="error.emptynullcheck" providers="provider">
            <v:param value="#root"></v:param>
        </v:message>
        </v:condition>
    </v:group>
    <v:group id="studentValidator">
        <v:condition test="#root != null and #root.Name != null">
        <v:message id="error.emptynullcheck" providers="provider">
            <v:param value="#root"></v:param>
        </v:message>
        </v:condition>
    </v:group>
</objects>
