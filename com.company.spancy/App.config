<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="appconfig" type="System.Configuration.NameValueSectionHandler"/>
    <sectionGroup name="spring">
      <section name="context" type="Spring.Context.Support.ContextHandler, Spring.Core"/>
      <section name="parsers" type="Spring.Context.Support.NamespaceParsersSectionHandler, Spring.Core"/>
      <section name="objects" type="Spring.Context.Support.DefaultSectionHandler, Spring.Core"/>
    </sectionGroup>
    <sectionGroup name="common">
      <section name="logging" type="Common.Logging.ConfigurationSectionHandler, Common.Logging"/>
    </sectionGroup>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
  </configSections>
  <spring>
    <context>
      <resource uri="file://config/modules.xml"/>
      <resource uri="file://config/aspects.xml"/>
      <resource uri="file://config/resources.xml"/>
      <resource uri="file://config/validators.xml"/>
      <resource uri="file://config/services.xml"/>
      <resource uri="file://config/daos.xml"/>
      <resource uri="file://config/mappers.xml"/>
      <resource uri="file://config/binders.xml"/>
    </context>
    <parsers>
      <parser type="Spring.Aop.Config.AopNamespaceParser, Spring.Aop"/>
      <parser type="Spring.Context.Config.ContextNamespaceParser, Spring.Core"/>
      <parser type="Spring.Data.Config.DatabaseNamespaceParser, Spring.Data"/>
      <parser type="Spring.Transaction.Config.TxNamespaceParser, Spring.Data"/>
    </parsers>
  </spring>
  <common>
    <logging>
      <factoryAdapter type="Common.Logging.Log4Net.Log4NetLoggerFactoryAdapter, Common.Logging.Log4Net1210">
        <arg key="configType" value="FILE-WATCH"/>
        <arg key="configFile" value="./config/log4net.xml"/>
      </factoryAdapter>
    </logging>
  </common>
  <appconfig configSource=".\config\application.xml"/>
  <startup> 
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Data.SQLite" publicKeyToken="db937bc2d44ff139" culture="neutral"/>
        <bindingRedirect oldVersion="1.0.65.0" newVersion="1.0.118.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>