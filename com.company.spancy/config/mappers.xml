  <object id="UserMapper" type="com.company.spancy.mapper.impl.UserMapper, com.company.spancy">
    <property name="Dao" ref="UserDao"/>
  </object>
  <object id="GroupMapper" type="com.company.spancy.mapper.impl.GroupMapper, com.company.spancy"></object>
  <object id="CategoryMapper" type="com.company.spancy.mapper.impl.CategoryMapper, com.company.spancy">
    <property name="Dao" ref="CategoryDao"/>
    <property name="Hql" value="from Category c where c.Id = :Id" />
  </object>
  <object id="StudentMapper" type="com.company.spancy.mapper.impl.StudentMapper, com.company.spancy">
    <property name="Dao" ref="StudentDao"/>
    <property name="Hql" value="from Student s where lower(s.Name) = lower(:Name)" />
  </object>
  <object id="PersonMapper" type="com.company.spancy.mapper.impl.PersonMapper, com.company.spancy">
    <property name="Dao" ref="PersonDao"/>
    <property name="Hql" value="from Person p where lower(p.Name) = lower(:Name)" />
  </object>
  <object id="ItemMapper" type="com.company.spancy.mapper.impl.ItemMapper, com.company.spancy">
    <property name="Dao" ref="ItemDao"/>
    <property name="Hql" value="from Item i where lower(i.Name) = lower(:Name)" />
  </object>
