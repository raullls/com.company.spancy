<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="com.company.spancy"
                   namespace="com.company.spancy.entity">

  <!-- more mapping info here -->
  <class name="User" table="Users">
    <id name="Id">
      <generator class="native" />
    </id>
    <property name="Name" />
    <bag name="Groups" table="UsersGroups" cascade="save-update">
      <key column="UserId"/>
      <many-to-many column="GroupId" class="Group"/>
    </bag>
  </class>

</hibernate-mapping>
<!--
CREATE TABLE "Users" (
	"Id"	INTEGER,
	"Name"	TEXT,
	PRIMARY KEY("Id" AUTOINCREMENT)
)
-->