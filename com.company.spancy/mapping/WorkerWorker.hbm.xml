<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="com.company.spancy"
                   namespace="com.company.spancy.entity">

  <!-- more mapping info here -->
  <class name="WorkerWorker" table="WorkersWorkers">
    <composite-id>
      <key-many-to-one name="Worker1" class="Worker" column="Worker1Id"/>
      <key-many-to-one name="Worker2" class="Worker" column="Worker2Id"/>
    </composite-id>
    <property name="Relationship" />
  </class>

</hibernate-mapping>
